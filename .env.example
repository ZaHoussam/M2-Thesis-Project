# ================================================================
#  Intelligent Laboratory Access Control System
#  Environment Variables — copy to .env and fill in your values
#  cp .env.example .env
# ================================================================

# ── PostgreSQL Database ─────────────────────────────────────────
POSTGRES_USER=mrlhou
POSTGRES_PASSWORD=mrlhou2001
POSTGRES_DB=lab_access
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Async connection string used by SQLAlchemy / asyncpg
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ── FastAPI Server ──────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DEBUG=false

# ArcFace threshold — start at 0.50, tune after testing
THRESHOLD_ALLOW=0.50

# ── Face Embedding ──────────────────────────────────────────────
# Expected dimensionality of face embeddings (must match model output)
EMBEDDING_DIM=512

# ── Client (Edge Device / Raspberry Pi) ─────────────────────────
# WebSocket URL pointing to the central server
SERVER_WS_URL=ws://localhost:8000/ws/verify
# Camera device index (0 = default webcam)
CAMERA_INDEX=0
# Lab ID this client device is assigned to
LAB_ID=1

# ── Logging ─────────────────────────────────────────────────────
LOG_LEVEL=INFO
